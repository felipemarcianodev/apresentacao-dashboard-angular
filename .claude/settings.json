{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/catalogo-de-testes.mjs\"",
            "timeout": 60,
            "statusMessage": "Atualizando o catálogo da galeria de testes"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/revisao-ptbr.mjs\" pos-edicao",
            "timeout": 10,
            "statusMessage": "Conferindo a acentuação do texto"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/verificar-documentacao.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Conferindo a documentação viva"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/revisao-ptbr.mjs\" parada",
            "timeout": 20,
            "statusMessage": "Conferindo a revisão de texto em pt-BR"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/revisao-ptbr.mjs\" commit",
            "timeout": 10,
            "statusMessage": "Conferindo o português da mensagem de commit"
          }
        ]
      }
    ]
  }
}
