# Mirante: SPA estática. Build no Node e entrega pelo nginx.
# Imagens fixadas por digest: uma tag alterada no registry não entra sem revisão. O Dependabot
# (ecossistema docker) abre PR quando sai um digest novo.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY angular.json tsconfig.json tsconfig.app.json .postcssrc.json ./
COPY public/ public/
COPY src/ src/
RUN npx ng build --configuration production

FROM nginx:1.31-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2
LABEL app=mirante
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/seguranca.conf /etc/nginx/snippets/seguranca.conf
COPY --from=build /app/dist/mirante/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/health || exit 1
