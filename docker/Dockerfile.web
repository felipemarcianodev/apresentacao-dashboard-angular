# Mirante: o site (frontend/). Build no Node e entrega pelo nginx, que também encaminha /api.
# Imagens fixadas por digest: uma tag alterada no registry não entra sem revisão. O Dependabot
# (ecossistema docker) abre PR quando sai um digest novo.
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS build
# Mesma estrutura do repositório: o front em frontend/ lê o VERSION da raiz.
WORKDIR /repo/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY VERSION /repo/VERSION
COPY frontend/angular.json frontend/tsconfig.json frontend/tsconfig.app.json frontend/.postcssrc.json ./
COPY frontend/public/ public/
COPY frontend/src/ src/
COPY frontend/scripts/rotas-publicas.mjs frontend/scripts/cartoes-por-rota.mjs scripts/
# ng build e, depois dele, o index.html de cada rota pública com o próprio cartão do link.
RUN npm run build:deploy

FROM nginx:1.30-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5
LABEL app=mirante
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/seguranca.conf /etc/nginx/snippets/seguranca.conf
COPY --from=build /repo/frontend/dist/mirante/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/health || exit 1
